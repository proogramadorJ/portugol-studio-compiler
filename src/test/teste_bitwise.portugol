    funcao inicio(){
           inteiro a = 10
           inteiro b = 20
           inteiro c = a & b
           escreva(a & b)
           escreva(c)
           c = a | b
           escreva(c)
           escreva(a | b)
           c = a ^ b
           escreva(c)
           escreva(a ^ b)
           c = a << b
           escreva(c)
           escreva(a << b)
           c = a >> b
           escreva(c)
           escreva(a >> b)
              
        }